<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{75DB148F-26CB-4EC4-AC7C-62AAD3C6362B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PaletteViewer</RootNamespace>
    <AssemblyName>PaletteViewer</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Optional: if this folder contains CSpect.exe, the built PaletteViewer.dll is copied into it after each build.
         Change it to point at your CSpect install, or leave it - the build works without it. -->
    <CSpectDir Condition=" '$(CSpectDir)' == '' ">$(MSBuildProjectDirectory)\..\..\CSpect4_0_1_0\</CSpectDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <!-- CSpect's own assemblies, copied into lib\ so the project builds on its own.
         Private=false: CSpect already ships these, so they are not copied to the output. -->
    <Reference Include="ImGui.NET">
      <HintPath>lib\ImGui.NET.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- ImGui.NET is compiled against System.Numerics.Vectors 4.1.3.0 (Vector2/Vector4). This is the
         4.1.4.0 copy CSpect ships (CSpect.exe.config redirects to it); it forwards the types to System.Numerics. -->
    <Reference Include="System.Numerics.Vectors">
      <HintPath>lib\System.Numerics.Vectors.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="FileBrowser.cs" />
    <Compile Include="PaletteFile.cs" />
    <Compile Include="PaletteViewerPlugin.cs" />
    <Compile Include="PaletteViewerView.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
    <None Include="lib\Plugin.dll" />
    <None Include="lib\ImGui.NET.dll" />
    <None Include="lib\System.Numerics.Vectors.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plugin\Plugin.csproj">
      <Project>{192437a5-3030-4606-bb5a-2c86ece66aef}</Project>
      <Name>Plugin</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyPluginToCSpect" AfterTargets="Build" Condition="Exists('$(CSpectDir)CSpect.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CSpectDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="PaletteViewer.dll copied to $(CSpectDir)" />
  </Target>
</Project>